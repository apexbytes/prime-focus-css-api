# ---- runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
DEFAULT_TIMEZONE=Africa/Harare

# ---- logging ----------------------------------------------------------------
LOG_LEVEL=debug
LOG_TO_FILE=false
LOG_DIR=logs

# ---- database ---------------------------------------------------------------
DATABASE_URL=postgres://css:css@localhost:5434/prime_focus_css
DB_POOL_MAX=10
DB_SSL=false
DB_STATEMENT_TIMEOUT_MS=15000

# ---- http -------------------------------------------------------------------
# '*' in development; a comma-separated allowlist in production.
CORS_ORIGINS=*
# Number of proxies in front of the API (nginx/ALB). Never use `true`.
TRUST_PROXY_HOPS=1
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---- lifecycle --------------------------------------------------------------
SHUTDOWN_TIMEOUT_MS=15000
READINESS_CHECK_TIMEOUT_MS=3000
GIT_COMMIT_SHA=unknown
# Reported by /healthz. npm scripts supply this automatically; set it explicitly
# when the process is started directly (systemd, Docker CMD).
APP_VERSION=1.0.0

# ---- phase 2: auth ----------------------------------------------------------
# JWT_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d
# JWT_KID=k1
# ENCRYPTION_KEY=
# MFA_ISSUER=Prime Focus Support

# ---- phase 3: email + storage ----------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM=support@primefocus.co.zw
# RESEND_INBOUND_SECRET=
# SUPPORT_INBOX_DOMAIN=support.primefocus.co.zw
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_KEY=
# STORAGE_SECRET=

# ---- phase 6: redis ---------------------------------------------------------
# REDIS_URL=
