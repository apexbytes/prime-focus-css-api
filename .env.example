# ---- runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
DEFAULT_TIMEZONE=Africa/Harare

# ---- logging ----------------------------------------------------------------
LOG_LEVEL=debug
LOG_TO_FILE=false
LOG_DIR=logs

# ---- database ---------------------------------------------------------------
DATABASE_URL=postgres://css:css@localhost:5434/prime_focus_css
DB_POOL_MAX=10
DB_SSL=false
DB_STATEMENT_TIMEOUT_MS=15000

# ---- http -------------------------------------------------------------------
# '*' in development; a comma-separated allowlist in production.
CORS_ORIGINS=*
# Number of proxies in front of the API (nginx/ALB). Never use `true`.
TRUST_PROXY_HOPS=1
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Tighter budget for credential endpoints (login, OTP, password reset, invite accept).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---- lifecycle --------------------------------------------------------------
SHUTDOWN_TIMEOUT_MS=15000
READINESS_CHECK_TIMEOUT_MS=3000
GIT_COMMIT_SHA=unknown
# Reported by /healthz. npm scripts supply this automatically; set it explicitly
# when the process is started directly (systemd, Docker CMD).
APP_VERSION=1.0.0

# ---- auth -------------------------------------------------------------------
# Required in production; the dev default is rejected there. Min 32 characters.
# Also keys the HMACs for OTP codes, refresh tokens, device tokens and API keys,
# so rotating it invalidates all of them.
# JWT_SECRET=
JWT_ISSUER=prime-focus-css
JWT_AUDIENCE=prime-focus-css-api
JWT_KID=k1
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# ---- email OTP (second factor) ---------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# How long a device may skip the OTP after passing it once.
TRUSTED_DEVICE_TTL_DAYS=30

# ---- invitations + password reset ------------------------------------------
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30
# Agent console base URL; invitation and reset links are built from it.
APP_WEB_URL=http://localhost:5173

# ---- email ------------------------------------------------------------------
# Without a key the transport falls back to logging the message, which is how
# development works. Production refuses to start without one unless
# EMAIL_TRANSPORT=log is set deliberately.
# RESEND_API_KEY=
RESEND_FROM=Prime Focus Support <support@primefocus.co.zw>
# RESEND_REPLY_TO=
# EMAIL_TRANSPORT=log

# ---- seed (npm run db:seed) -------------------------------------------------
# The one account that exists before anyone is invited. If no password is given,
# one is generated and printed once.
SEED_ADMIN_EMAIL=admin@primefocus.co.zw
SEED_ADMIN_NAME=Prime Focus Administrator
# SEED_ADMIN_PASSWORD=

# ---- phase 3: inbound email + storage --------------------------------------
# RESEND_INBOUND_SECRET=
# SUPPORT_INBOX_DOMAIN=support.primefocus.co.zw
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_KEY=
# STORAGE_SECRET=

# ---- async jobs (pg-boss) ---------------------------------------------------
# `inline` runs a job the instant it is enqueued and fires no schedule at all.
# Tests default to it; leave this unset everywhere else, or the SLA scan — and
# therefore every breach and escalation — never runs.
# QUEUE_DRIVER=pgboss
QUEUE_SCHEMA=pgboss
QUEUE_CONCURRENCY=2
QUEUE_JOB_EXPIRY_SECONDS=300
QUEUE_RETRY_LIMIT=3

# ---- service levels ---------------------------------------------------------
# Every minute: an SLA is quoted in minutes, so a coarser schedule would make the
# recorded breach time wrong.
SLA_SCAN_CRON=* * * * *
SLA_SCAN_BATCH_SIZE=500

# ---- routing ----------------------------------------------------------------
# Off leaves every new ticket in the unassigned queue for agents to claim.
AUTO_ASSIGN_ENABLED=true
# Whether an `away` agent may be given work when nobody is online.
ROUTING_ASSIGN_TO_AWAY_AGENTS=false
# Applies to any agent with no limit of their own.
DEFAULT_AGENT_MAX_OPEN_TICKETS=20

# ---- phase 6: redis ---------------------------------------------------------
# REDIS_URL=

SEND_TICKET_ACKNOWLEDGEMENT=true
