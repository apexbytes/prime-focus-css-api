# ---- runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
DEFAULT_TIMEZONE=Africa/Harare

# ---- logging ----------------------------------------------------------------
LOG_LEVEL=debug
LOG_TO_FILE=false
LOG_DIR=logs

# ---- database ---------------------------------------------------------------
DATABASE_URL=postgres://css:css@localhost:5434/prime_focus_css
DB_POOL_MAX=10
DB_SSL=false
DB_STATEMENT_TIMEOUT_MS=15000

# ---- http -------------------------------------------------------------------
# '*' in development; a comma-separated allowlist in production.
CORS_ORIGINS=*
# Number of proxies in front of the API (nginx/ALB). Never use `true`.
TRUST_PROXY_HOPS=1
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Tighter budget for credential endpoints (login, OTP, password reset, invite accept).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---- lifecycle --------------------------------------------------------------
SHUTDOWN_TIMEOUT_MS=15000
READINESS_CHECK_TIMEOUT_MS=3000
GIT_COMMIT_SHA=unknown
# Reported by /healthz. npm scripts supply this automatically; set it explicitly
# when the process is started directly (systemd, Docker CMD).
APP_VERSION=1.0.0

# ---- auth -------------------------------------------------------------------
# Required in production; the dev default is rejected there. Min 32 characters.
# Also keys the HMACs for OTP codes, refresh tokens, device tokens and API keys,
# so rotating it invalidates all of them.
# JWT_SECRET=
JWT_ISSUER=prime-focus-css
JWT_AUDIENCE=prime-focus-css-api
JWT_KID=k1
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# ---- email OTP (second factor) ---------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# How long a device may skip the OTP after passing it once.
TRUSTED_DEVICE_TTL_DAYS=30

# ---- invitations + password reset ------------------------------------------
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30
# Agent console base URL; invitation and reset links are built from it.
APP_WEB_URL=http://localhost:5173

# ---- email ------------------------------------------------------------------
# Without a key the transport falls back to logging the message, which is how
# development works. Production refuses to start without one unless
# EMAIL_TRANSPORT=log is set deliberately.
# RESEND_API_KEY=
RESEND_FROM=Prime Focus Support <support@primefocus.co.zw>
# RESEND_REPLY_TO=
# EMAIL_TRANSPORT=log

# ---- seed (npm run db:seed) -------------------------------------------------
# The one account that exists before anyone is invited. If no password is given,
# one is generated and printed once.
SEED_ADMIN_EMAIL=admin@primefocus.co.zw
SEED_ADMIN_NAME=Prime Focus Administrator
# SEED_ADMIN_PASSWORD=

# ---- phase 3: inbound email + storage --------------------------------------
# RESEND_INBOUND_SECRET=
# SUPPORT_INBOX_DOMAIN=support.primefocus.co.zw
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_KEY=
# STORAGE_SECRET=

# ---- async jobs (pg-boss) ---------------------------------------------------
# `inline` runs a job the instant it is enqueued and fires no schedule at all.
# Tests default to it; leave this unset everywhere else, or the SLA scan — and
# therefore every breach and escalation — never runs.
# QUEUE_DRIVER=pgboss
QUEUE_SCHEMA=pgboss
QUEUE_CONCURRENCY=2
QUEUE_JOB_EXPIRY_SECONDS=300
QUEUE_RETRY_LIMIT=3

# ---- service levels ---------------------------------------------------------
# Every minute: an SLA is quoted in minutes, so a coarser schedule would make the
# recorded breach time wrong.
SLA_SCAN_CRON=* * * * *
SLA_SCAN_BATCH_SIZE=500

# ---- routing ----------------------------------------------------------------
# Off leaves every new ticket in the unassigned queue for agents to claim.
AUTO_ASSIGN_ENABLED=true
# Whether an `away` agent may be given work when nobody is online.
ROUTING_ASSIGN_TO_AWAY_AGENTS=false
# Applies to any agent with no limit of their own.
DEFAULT_AGENT_MAX_OPEN_TICKETS=20

# ---- knowledge base ---------------------------------------------------------
# Articles offered by GET /kb/suggest during the ticket-creation flow.
KB_SUGGEST_LIMIT=5

# ---- customer satisfaction (CSAT) -------------------------------------------
# Off sends nothing; surveys already dispatched stay answerable.
CSAT_ENABLED=true
# Delay between resolving a ticket and asking about it. Long enough that a
# customer about to say "that did not work" reopens the ticket instead of rating
# a resolution that did not hold.
CSAT_DELAY_MINUTES=60
CSAT_TOKEN_TTL_DAYS=14
# Minimum gap between surveys to one customer. Five tickets in a week is one ask.
CSAT_CUSTOMER_COOLDOWN_DAYS=7

# ---- reporting --------------------------------------------------------------
# How often the materialised views are rebuilt. A dashboard is allowed to be a
# quarter of an hour behind; that is what keeps reporting off the live tables.
REPORT_REFRESH_CRON=*/15 * * * *

# ---- attachment scanning ----------------------------------------------------
# Unset means `none`: uploads are recorded as `skipped`, honest about the fact
# that nothing looked at them. Production refuses to boot without either a
# scanner host or an explicit ANTIVIRUS_DRIVER=none.
# ANTIVIRUS_DRIVER=clamav
# ANTIVIRUS_HOST=clamav
ANTIVIRUS_PORT=3310
ANTIVIRUS_TIMEOUT_MS=30000
# Must not exceed clamd's own StreamMaxLength, or it drops the connection.
ANTIVIRUS_MAX_BYTES=26214400

# ---- notification digest ----------------------------------------------------
# 07:00 in DEFAULT_TIMEZONE, so it is read on arrival rather than competing with
# the queue it describes.
NOTIFICATION_DIGEST_CRON=0 7 * * *
NOTIFICATION_DIGEST_ENABLED=true

# ---- data retention ---------------------------------------------------------
# Zimbabwe's Cyber and Data Protection Act (2021): seven years of audit trail,
# five of ticket content, then customer PII anonymised in place. The sweep
# destroys data — RETENTION_AUDIT_LOG_YEARS must be >= RETENTION_TICKET_YEARS or
# it refuses to run.
RETENTION_SWEEP_CRON=0 3 * * 0
RETENTION_SWEEP_ENABLED=true
RETENTION_AUDIT_LOG_YEARS=7
RETENTION_TICKET_YEARS=5
RETENTION_SWEEP_BATCH_SIZE=500

# ---- cache & shared state ---------------------------------------------------
# Without Redis the cache, the rate-limit counters and the socket fan-out are
# per-process: correct for one instance, quietly wrong for two. Production
# refuses to boot without a URL unless CACHE_DRIVER=memory is set on purpose.
# The compose file publishes Redis on 6381, following the database's 5434.
REDIS_URL=redis://localhost:6381
# CACHE_DRIVER=memory
# Namespace on a shared Redis, so two environments cannot read each other.
REDIS_KEY_PREFIX=pfcss:
REDIS_CONNECT_TIMEOUT_MS=5000
# How long a cached KB suggestion stays usable. Short: an article unpublished
# for being wrong has to stop being offered within the minute.
KB_SUGGEST_CACHE_TTL_SECONDS=60

# ---- realtime ---------------------------------------------------------------
# Off serves the REST API alone and the console falls back to polling.
REALTIME_ENABLED=true
# Socket.IO mount path. Proxied as-is; distinct from every REST route.
REALTIME_PATH=/realtime
# A ticket lock is advisory and expires on its own, so a closed laptop does not
# make a customer's ticket look owned for the rest of the afternoon.
TICKET_LOCK_TTL_SECONDS=120
TICKET_LOCK_HEARTBEAT_SECONDS=30
# How often an open socket re-checks that its account is still active. The
# access token is deliberately not re-verified — it expires every 15 minutes.
REALTIME_REAUTH_SECONDS=300

# ---- outbound webhooks ------------------------------------------------------
WEBHOOK_TIMEOUT_MS=10000
# Attempts per delivery, including the first.
WEBHOOK_MAX_ATTEMPTS=5
# Consecutive failed deliveries before a subscription is switched off, so a
# decommissioned host is not retried for every event forever.
WEBHOOK_DISABLE_AFTER_FAILURES=20
# Delivery log rows are operational debris; the retention sweep drops them.
WEBHOOK_DELIVERY_RETENTION_DAYS=30

# ---- per-API-key quota ------------------------------------------------------
# A product system's own budget, keyed on its API key rather than its IP, so a
# chatty integration does not spend what every browser behind the same NAT
# shares.
API_KEY_RATE_LIMIT_WINDOW_MS=60000
API_KEY_RATE_LIMIT_MAX=1000

# ---- federated sign-in (SSO) ------------------------------------------------
# Providers themselves are rows, configured through /identity-providers by a
# holder of `sso:manage` — issuer, client credentials and the email domains each
# is allowed to vouch for. What is here is the plumbing around them.
#
# Where the provider sends the browser back. It is a **console** route, not an API
# route: the console reads `code` and `state` out of its own URL and posts them to
# /auth/sso/callback, which is how the session tokens stay out of a URL. Register
# this exact value with each provider. Derived from APP_WEB_URL when unset.
# SSO_REDIRECT_URL=http://localhost:5173/auth/sso/callback
# How long a started sign-in stays completable.
SSO_LOGIN_REQUEST_TTL_MINUTES=10
# How long a provider's OpenID discovery document is reused. Signing keys are
# cached separately, by kid, and refetched when an unknown one appears.
SSO_DISCOVERY_CACHE_SECONDS=3600
SSO_HTTP_TIMEOUT_MS=8000
# Allows an http or loopback issuer, which is what the test suite's own provider
# is. Production refuses to boot with it on.
# SSO_ALLOW_INSECURE_ISSUER=false

SEND_TICKET_ACKNOWLEDGEMENT=true

# ---- phase 8: WhatsApp ------------------------------------------------------
# Meta Cloud API. Leave the token and phone-number id unset and the transport
# resolves to `log`: nothing is sent, and what would have been sent is readable
# from the outbox — which is how development and the test suite run.
#
# The app secret keys the X-Hub-Signature-256 on every inbound webhook. Without
# it the ingress refuses everything, deliberately: an unverified inbound endpoint
# is a way to post messages to the desk as any phone number.
# WHATSAPP_APP_SECRET=
# The number replies are sent from, as Meta's id for it rather than the number.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# The string Meta echoes back when it verifies the webhook URL. A value of its
# own rather than the app secret, because it travels in a query string and
# nothing that signs anything is allowed to do that.
# WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_HTTP_TIMEOUT_MS=10000
# `cloud` or `log`. Derived from the two credentials above when unset.
# WHATSAPP_TRANSPORT=log
# Which product a WhatsApp conversation lands in, by code. One number serves the
# whole business, so unlike inbound email there is nothing in the message that
# says which product it is about; routing rules move it from here. Falls back to
# DEFAULT_PRODUCT_CODE.
# WHATSAPP_PRODUCT_CODE=pf_wallet
# Meta's customer-service window. 24 is the platform's rule, not a preference:
# outside it a free-form reply is refused and only an approved template gets
# through. Configurable so a change on Meta's side needs no deploy.
WHATSAPP_SERVICE_WINDOW_HOURS=24
# The approved template used to re-open a conversation past that window, and the
# language it is approved in. Unset means an agent replying late is told the reply
# could not be delivered, rather than a template being invented on their behalf.
# WHATSAPP_REOPEN_TEMPLATE=
WHATSAPP_REOPEN_TEMPLATE_LANGUAGE=en

# ---- phase 8: live chat -----------------------------------------------------
CHAT_ENABLED=true
# Socket.IO namespace the visitor widget connects to, on REALTIME_PATH. Its own
# namespace rather than rooms on the staff connection: a visitor is a member of
# the public, and the isolation is structural rather than a check to remember.
CHAT_NAMESPACE=/chat
# How long a visitor's session token is good for. Long enough to survive a page
# reload mid-conversation, short enough that a token left in a shared browser is
# not a way back into the thread tomorrow.
CHAT_SESSION_TTL_MINUTES=120
# CHAT_PRODUCT_CODE=pf_wallet
# Messages one session may send per minute. A widget is unauthenticated by
# construction, so this is the only thing between a bored visitor and a thousand
# ticket messages. Enforced in the service, because a socket frame never passes
# through the Express limiters.
CHAT_MESSAGE_RATE_PER_MINUTE=30

# ---- phase 8: conversation threads ------------------------------------------
# How long a channel thread may sit idle before its ticket pointer is dropped, so
# the next message opens new work instead of reopening something finished. The
# thread row itself survives: it holds the identity a returning customer is
# recognised by.
CONVERSATION_IDLE_HOURS=168
CONVERSATION_SWEEP_CRON=20 * * * *
